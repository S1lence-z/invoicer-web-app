@using Frontend.Utils
@using Microsoft.Extensions.Localization
@using Application.DTOs
@using Shared.Enums
@using Shared.Extensions
@using Frontend.Extensions
@inject IStringLocalizer<InvoicePreview> L
@inject IStringLocalizer<Frontend.Localization.EnumResources> EnumL

@* Mirrors the exported PDF: parties, items, registration text, totals, signature bottom right. *@
<div class="iv-doc">
    <div class="iv-doc-head">
        <div class="iv-doc-title">
            <span class="iv-doc-kind">@L["HeaderTitle"]</span>
            <span class="iv-num iv-doc-number">@L["InvoiceNumberLabel"] @Invoice.InvoiceNumber</span>
            <span class="iv-doc-status @StatusClass">@EnumL.Localize(Invoice.Status)</span>
        </div>
        <div class="iv-doc-meta">
            <div class="iv-doc-meta-row">
                <span>@L["IssueDateLabel"]</span>
                <span class="iv-num">@Invoice.IssueDate.FormatByCurrencyLocale(Invoice.Currency)</span>
            </div>
            <div class="iv-doc-meta-row">
                <span>@L["DueDateLabel"]</span>
                <span class="iv-num">@Invoice.DueDate.FormatByCurrencyLocale(Invoice.Currency)</span>
            </div>
            <div class="iv-doc-meta-row">
                <span>@L["VatDateLabel"]</span>
                <span class="iv-num">@Invoice.VatDate.FormatByCurrencyLocale(Invoice.Currency)</span>
            </div>
            @if (Invoice.PaymentMethod is { } paymentMethod)
            {
                <div class="iv-doc-meta-row">
                    <span>@L["PaymentMethodLabel"]</span>
                    <span>@EnumL.Localize(paymentMethod)</span>
                </div>
            }
            @if (Invoice.DeliveryMethod is { } deliveryMethod)
            {
                <div class="iv-doc-meta-row">
                    <span>@L["DeliveryMethodLabel"]</span>
                    <span>@EnumL.Localize(deliveryMethod)</span>
                </div>
            }
        </div>
    </div>

    <div class="iv-doc-rule"></div>

    <div class="iv-doc-parties">
        <div class="iv-doc-party">
            <span class="iv-label">@L["SellerSectionTitle"]</span>
            <span class="iv-doc-party-name">@Invoice.Seller?.Name</span>
            @if (!string.IsNullOrWhiteSpace(Invoice.Seller?.Ico))
            {
                <span>@L["IcoLabel"] @Invoice.Seller!.Ico</span>
            }
            <span>@FormatAddress(Invoice.Seller)</span>
            @if (!string.IsNullOrWhiteSpace(Invoice.Seller?.Email))
            {
                <span>@Invoice.Seller!.Email</span>
            }
            @if (Invoice.Seller?.BankAccount is { } sellerBank)
            {
                <span>@sellerBank.BankName · @sellerBank.AccountNumber/@sellerBank.BankCode</span>
            }
        </div>
        <div class="iv-doc-party">
            <span class="iv-label">@L["BuyerSectionTitle"]</span>
            <span class="iv-doc-party-name">@Invoice.Buyer?.Name</span>
            @if (!string.IsNullOrWhiteSpace(Invoice.Buyer?.Ico))
            {
                <span>@L["IcoLabel"] @Invoice.Buyer!.Ico</span>
            }
            <span>@FormatAddress(Invoice.Buyer)</span>
            @if (!string.IsNullOrWhiteSpace(Invoice.Buyer?.Email))
            {
                <span>@Invoice.Buyer!.Email</span>
            }
        </div>
    </div>

    <div class="iv-doc-items">
        <div class="iv-doc-item iv-doc-item-head iv-label">
            <span>@L["TableHeaderDescription"]</span>
            <span class="iv-right">@L["TableHeaderQty"]</span>
            <span class="iv-right">@L["TableHeaderUnitPrice"]</span>
            <span class="iv-right">@L["TableHeaderVatRate"]</span>
            <span class="iv-right">@L["TableHeaderTotal"]</span>
        </div>
        @foreach (var item in Invoice.Items)
        {
            <div class="iv-doc-item">
                <span>@item.Description</span>
                <span class="iv-num iv-right">@item.Quantity @item.Unit</span>
                <span class="iv-num iv-right">@Invoice.Currency.FormatAmount(item.UnitPrice)</span>
                <span class="iv-num iv-right">@((item.VatRate * 100).ToString("F0")) %</span>
                <span class="iv-num iv-right iv-doc-item-total">@Invoice.Currency.FormatAmount(item.Quantity * item.UnitPrice)</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Invoice.Seller?.RegistrationText))
    {
        <span class="iv-doc-note">@Invoice.Seller!.RegistrationText</span>
    }

    <div class="iv-doc-totals">
        <div class="iv-doc-totals-inner">
            <div class="iv-doc-total-row">
                <span>@L["TotalPriceWithoutVatLabel"]</span>
                <span class="iv-num">@Invoice.Currency.FormatAmount(TotalNet)</span>
            </div>
            <div class="iv-doc-total-row">
                <span>@L["TotalVatLabel"]</span>
                <span class="iv-num">@Invoice.Currency.FormatAmount(TotalVat)</span>
            </div>
            <div class="iv-doc-total-row iv-doc-total-final">
                <span>@L["FinalPriceLabel"]</span>
                <span class="iv-num">@Invoice.Currency.FormatAmount(TotalNet + TotalVat)</span>
            </div>
        </div>
    </div>

    <div class="iv-doc-signature">
        <div class="iv-doc-signature-block">
            <div class="iv-doc-signature-line"></div>
            <span>@L["SignedByLabel"] <strong>@Invoice.SignedBy</strong></span>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public InvoiceDto Invoice { get; set; } = null!;

    private decimal TotalNet => Invoice.Items.Sum(i => i.Quantity * i.UnitPrice);

    private decimal TotalVat => Invoice.Items.Sum(i => i.Quantity * i.UnitPrice * i.VatRate);

    private string StatusClass => Invoice.Status switch
    {
        InvoiceStatus.Pending => "iv-status-pending",
        InvoiceStatus.Paid => "iv-status-paid",
        InvoiceStatus.Overdue => "iv-status-overdue",
        _ => "iv-status-draft"
    };

    private static string FormatAddress(EntityDto? entity)
    {
        if (entity?.Address is not { } address)
            return string.Empty;

        return $"{address.Street}, {address.ZipCode} {address.City}, {address.Country}";
    }
}
