@using System.Globalization
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@* Two pills rather than a select: there are only ever two languages. *@
<div class="iv-culture">
    @foreach (var culture in supportedCultures)
    {
        <button type="button"
                class="iv-culture-option @(IsCurrent(culture) ? "active" : null)"
                title="@culture.NativeName"
                @onclick="() => SwitchCulture(culture.Name)">
            @ShortName(culture)
        </button>
    }
</div>

@code {
    private readonly CultureInfo[] supportedCultures =
    [
        new CultureInfo("cs-CZ"),
        new CultureInfo("en-US")
    ];

    private static bool IsCurrent(CultureInfo culture) => CultureInfo.CurrentCulture.Name == culture.Name;

    private static string ShortName(CultureInfo culture) => culture.TwoLetterISOLanguageName.ToUpperInvariant();

    private async Task SwitchCulture(string cultureName)
    {
        if (CultureInfo.CurrentCulture.Name == cultureName)
            return;

        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "blazorCulture", cultureName);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
