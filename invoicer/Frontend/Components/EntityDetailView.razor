@using Application.DTOs
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EntityDetailView> L

<div class="iv-detail">
    <div class="iv-detail-head">
        <span class="iv-detail-name">@SelectedEntity.Name</span>
        <span class="iv-detail-kind">@(SelectedEntity.IsClient ? L["ClientCaption"] : L["MineCaption"])</span>
    </div>

    <div class="iv-detail-section">
        <span class="iv-label">@L["ContactSectionTitle"]</span>
        <div class="iv-detail-row"><span>@L["IcoLabel"]</span><span class="iv-num">@SelectedEntity.Ico</span></div>
        <div class="iv-detail-row"><span>@L["EmailLabel"]</span><span>@SelectedEntity.Email</span></div>
        <div class="iv-detail-row"><span>@L["PhoneLabel"]</span><span class="iv-num">@SelectedEntity.PhoneNumber</span></div>
    </div>

    <div class="iv-doc-rule"></div>

    <div class="iv-detail-section">
        <span class="iv-label">@L["BankAccountSectionTitle"]</span>
        <div class="iv-detail-row"><span>@L["BankNameLabel"]</span><span>@SelectedEntity.BankAccount?.BankName</span></div>
        <div class="iv-detail-row"><span>@L["AccountNumberLabel"]</span><span class="iv-num">@SelectedEntity.BankAccount?.AccountNumber</span></div>
        <div class="iv-detail-row"><span>@L["BankCodeLabel"]</span><span class="iv-num">@SelectedEntity.BankAccount?.BankCode</span></div>
        <div class="iv-detail-row"><span>@L["IBANLabel"]</span><span class="iv-num">@SelectedEntity.BankAccount?.IBAN</span></div>
    </div>

    <div class="iv-doc-rule"></div>

    <div class="iv-detail-section">
        <span class="iv-label">@L["AddressSectionTitle"]</span>
        <div class="iv-detail-row"><span>@L["StreetLabel"]</span><span>@SelectedEntity.Address?.Street</span></div>
        <div class="iv-detail-row"><span>@L["CityLabel"]</span><span>@SelectedEntity.Address?.City</span></div>
        <div class="iv-detail-row"><span>@L["ZipCodeLabel"]</span><span class="iv-num">@SelectedEntity.Address?.ZipCode</span></div>
        <div class="iv-detail-row"><span>@L["CountryLabel"]</span><span>@SelectedEntity.Address?.Country</span></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(SelectedEntity.RegistrationText))
    {
        <div class="iv-doc-rule"></div>
        <div class="iv-detail-section">
            <span class="iv-label">@L["RegistrationTextLabel"]</span>
            <span class="iv-detail-note">@SelectedEntity.RegistrationText</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public EntityDto SelectedEntity { get; set; } = null!;
}
