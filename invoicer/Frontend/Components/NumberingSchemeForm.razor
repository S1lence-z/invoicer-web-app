@using Frontend.Models
@using Frontend.Services
@using Frontend.Utils
@using Microsoft.Extensions.Localization
@using Application.DTOs
@using Application.Extensions
@using Shared.Enums
@using Shared.Extensions
@using Frontend.Extensions
@using Application.ServiceInterfaces
@inject INumberingSchemeService numberingService
@inject LoadingService loadingService
@inject ErrorService errorService
@inject IStringLocalizer<NumberingSchemeForm> L
@inject IStringLocalizer<Frontend.Localization.EnumResources> EnumL

<EditForm Model="@SchemeFormModel" OnValidSubmit="SubmitForm">
    <DataAnnotationsValidator />

    <div class="iv-form">
        @* The number the scheme produces, updated as the fields change. *@
        <div class="iv-scheme-preview-box">
            <span class="iv-label">@L["PreviewLabel"]</span>
            <span class="iv-num iv-scheme-preview-value">@PreviewNumber</span>
        </div>

        <div class="iv-card">
            <span class="iv-label">@L["SectionFormat"]</span>
            <div class="iv-grid-3">
                <div class="iv-field">
                    <label class="iv-field-label" for="prefix">@L["PrefixLabel"]</label>
                    <input id="prefix" type="text" class="form-control" placeholder="@L["PrefixPlaceholder"]" @bind="SchemeFormModel.Prefix" />
                    <ValidationMessage For="@(() => SchemeFormModel.Prefix)" />
                </div>
                @if (SchemeFormModel.UseSeperator)
                {
                    <div class="iv-field">
                        <label class="iv-field-label" for="seperator">@L["SeparatorLabel"]</label>
                        <input id="seperator" type="text" class="form-control" placeholder="@L["SeparatorPlaceholder"]" @bind="SchemeFormModel.Seperator" @bind:after="AfterSeperatorChange" />
                        <ValidationMessage For="@(() => SchemeFormModel.Seperator)" />
                    </div>
                }
                <div class="iv-field">
                    <label class="iv-field-label" for="sequence-padding">@L["PaddingLabel"]</label>
                    <input id="sequence-padding" type="number" min="1" step="1" class="form-control iv-num" placeholder="@L["PaddingPlaceholder"]" @bind="SchemeFormModel.SequencePadding" />
                    <ValidationMessage For="@(() => SchemeFormModel.SequencePadding)" />
                </div>
            </div>
            <div class="iv-grid-3">
                <div class="iv-field">
                    <label class="iv-field-label" for="sequence-pos">@L["SequencePositionLabel"]</label>
                    <select id="sequence-pos" class="form-select" @bind="SchemeFormModel.SequencePosition">
                        @foreach (Position value in Enum.GetValues<Position>())
                        {
                            <option value="@value">@EnumL.Localize(value)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => SchemeFormModel.SequencePosition)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="reset-frequency">@L["ResetFrequencyLabel"]</label>
                    <select id="reset-frequency" class="form-select" @bind="SchemeFormModel.ResetFrequency">
                        @foreach (ResetFrequency value in Enum.GetValues<ResetFrequency>())
                        {
                            <option value="@value">@EnumL.Localize(value)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => SchemeFormModel.ResetFrequency)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="year-format">@L["YearFormatLabel"]</label>
                    <select id="year-format" class="form-select" @bind="SchemeFormModel.YearFormat">
                        @foreach (YearFormat value in Enum.GetValues<YearFormat>())
                        {
                            <option value="@value">@EnumL.Localize(value)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => SchemeFormModel.YearFormat)" />
                </div>
            </div>
        </div>

        <div class="iv-card">
            <span class="iv-label">@L["SectionOptions"]</span>

            <label class="iv-switch">
                <input type="checkbox" @bind="SchemeFormModel.UseSeperator" @bind:after="AfterSeperatorChange" />
                <span class="iv-switch-track"><span class="iv-switch-knob"></span></span>
                <span class="iv-switch-label">@L["UseSeparatorLabel"]</span>
            </label>

            <label class="iv-switch">
                <input type="checkbox" @bind="SchemeFormModel.IncludeMonth" />
                <span class="iv-switch-track"><span class="iv-switch-knob"></span></span>
                <span class="iv-switch-label">@L["IncludeMonthLabel"]</span>
            </label>

            @if (NumberingSchemeInstance is not null && NumberingSchemeInstance.IsDefault)
            {
                <span class="iv-field-hint">@L["IsDefaultInformationLabel"]: @(SchemeFormModel.IsDefault ? L["Yes"] : L["No"])</span>
            }
            else
            {
                <label class="iv-switch">
                    <input type="checkbox" @bind="SchemeFormModel.IsDefault" />
                    <span class="iv-switch-track"><span class="iv-switch-knob"></span></span>
                    <span class="iv-switch-label">@L["SetAsDefaultLabel"]</span>
                </label>
                <ValidationMessage For="@(() => SchemeFormModel.IsDefault)" />
            }
        </div>
    </div>

    <div class="iv-formbar">
        <div class="iv-formbar-actions">
            <button type="submit" class="btn btn-primary" disabled="@loadingService.IsLoading">@(NumberingSchemeInstance is null ? L["CreateButtonText"] : L["SaveButtonText"])</button>
        </div>
    </div>
</EditForm>

@code {
    /// <summary>The invoice number this scheme would produce right now.</summary>
    private string PreviewNumber => SchemeFormModel.ToDto().ShowNumberingSchemePreview();

    [Parameter] public EventCallback SubmitCallback { get; set; }
    [Parameter] public NumberingSchemeDto? NumberingSchemeInstance { get; set; } = null!;
    [Parameter] public bool isActive { get; set; }

    // Form Model
    private NumberingSchemeFormModel SchemeFormModel { get; set; } = new();

    // Methods
    protected override void OnParametersSet()
    {
        if (NumberingSchemeInstance is not null)
            SchemeFormModel = NumberingSchemeFormModel.FromDto(NumberingSchemeInstance);
        if (!isActive)
            ResetForm();
    }

    private void ResetForm()
    {
        SchemeFormModel.ClearModel();
    }

    private async Task SubmitForm()
    {
        loadingService.StartLoading();
        try
        {
            if (NumberingSchemeInstance is null)
                await SubmitNewScheme();
            else
                await SubmitEditScheme();
            await SubmitCallback.InvokeAsync();
            ResetForm();
        }
        catch (Exception e)
        {
            errorService.ShowError(e.Message);
        }
        finally
        {
            loadingService.StopLoading();
        }
    }

    private async Task SubmitNewScheme()
    {
        try
        {
            NumberingSchemeDto newScheme = SchemeFormModel.ToDto();
            NumberingSchemeDto? createdScheme = await numberingService.CreateAsync(newScheme);
        }
        catch (Exception e)
        {
            errorService.ShowError(e.Message);
        }
    }

    private async Task SubmitEditScheme()
    {
        try
        {
            if (NumberingSchemeInstance is null)
                return;
            NumberingSchemeDto updatedScheme = SchemeFormModel.ToDto();
            await numberingService.UpdateAsync(updatedScheme.Id, updatedScheme);
        }
        catch (Exception e)
        {
            errorService.ShowError(e.Message);
        }
    }

    private void AfterSeperatorChange()
    {
        if (string.IsNullOrEmpty(SchemeFormModel.Seperator))
        {
            SchemeFormModel.UseSeperator = false;
            SchemeFormModel.Seperator = NumberingSchemeDto.DefaultSeparator;
        }
        else
            SchemeFormModel.Seperator = SchemeFormModel.Seperator.Trim();
    }
}