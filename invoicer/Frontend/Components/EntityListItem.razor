@using Application.DTOs
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EntityListItem> L

<div class="iv-entity-card @(IsSelected ? "selected" : null)" @onclick="() => OnSelectEntity.InvokeAsync(Entity)">
    <div class="iv-entity-top">
        <span class="iv-entity-name">@Entity.Name</span>
        <span class="iv-entity-badge @(Entity.IsClient ? "client" : "mine")">@(Entity.IsClient ? L["ClientLabel"] : L["MeLabel"])</span>
    </div>
    <span class="iv-entity-line">@BankLine</span>
    <span class="iv-entity-line">@AddressLine</span>
    <div class="iv-entity-actions">
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => OnEditEntity.InvokeAsync(Entity)" @onclick:stopPropagation="true">@L["EditButton"]</button>
        <button class="btn btn-outline-danger btn-sm" @onclick="() => OnDeleteEntity.InvokeAsync(Entity)" @onclick:stopPropagation="true">@L["DeleteButton"]</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EntityDto Entity { get; set; } = null!;

    [Parameter]
    public EventCallback<EntityDto> OnSelectEntity { get; set; }

    [Parameter]
    public EventCallback<EntityDto> OnDeleteEntity { get; set; }

    [Parameter]
    public EventCallback<EntityDto> OnEditEntity { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    private string BankLine => Entity.BankAccount is { } bank
        ? $"{bank.BankName} ({bank.AccountNumber}/{bank.BankCode})"
        : string.Empty;

    private string AddressLine => Entity.Address is { } address
        ? $"{address.Street}, {address.City}"
        : string.Empty;
}
