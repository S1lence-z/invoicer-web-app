@using Application.DTOs
@using Application.Extensions
@using Frontend.Utils
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<NumberingSchemeListItem> L

@* A scheme is easiest to judge by the number it produces. *@
<div class="iv-scheme-row">
    <div class="iv-scheme-main">
        <span class="iv-num iv-scheme-preview">@NumberingScheme.ShowNumberingSchemePreview()</span>
        <span class="iv-scheme-detail">@Summary</span>
    </div>
    <div class="iv-scheme-actions">
        <span class="iv-scheme-default @(NumberingScheme.IsDefault ? "on" : null)">
            @L["DefaultLabel"] @(NumberingScheme.IsDefault ? L["YesOption"] : L["NoOption"])
        </span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="() => OnEditNumberingScheme.InvokeAsync(NumberingScheme)">@L["EditButton"]</button>
        <button class="btn btn-outline-danger btn-sm" @onclick="() => OnDeleteNumberingScheme.InvokeAsync(NumberingScheme)">@L["DeleteButton"]</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public NumberingSchemeDto NumberingScheme { get; set; } = null!;

    [Parameter]
    public EventCallback<NumberingSchemeDto> OnDeleteNumberingScheme { get; set; }

    [Parameter]
    public EventCallback<NumberingSchemeDto> OnEditNumberingScheme { get; set; }

    private string Summary
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(NumberingScheme.Prefix))
                parts.Add($"{L["SummaryPrefix"]} {NumberingScheme.Prefix}");
            parts.Add($"{L["SummaryPadding"]} {NumberingScheme.SequencePadding}");
            parts.Add($"{L["SummaryReset"]} {NumberingScheme.ResetFrequency.ToString().ToLowerInvariant()}");
            return string.Join(" · ", parts);
        }
    }
}
