@using System.Net
@using Application.DTOs
@using Application.ServiceInterfaces
@using Frontend.Models
@using Frontend.Services
@using Frontend.Utils
@using Microsoft.Extensions.Localization
@using Shared.Enums
@using Shared.Extensions
@using Frontend.Extensions
@using static System.Web.HttpUtility

@inject IInvoiceService invoiceService
@inject IEntityService entityService
@inject ErrorService errorService
@inject LoadingService loadingService
@inject NavigationManager navigationManager
@inject IStringLocalizer<InvoiceForm> L
@inject IStringLocalizer<Frontend.Localization.EnumResources> EnumL

<EditForm Model="@InvoiceFormModel" OnValidSubmit="SubmitForm">
    <DataAnnotationsValidator />

    <div class="iv-form">
        @* INVOICE *@
        <div class="iv-card">
            <span class="iv-label">@L["SectionInvoice"]</span>
            <div class="iv-grid-3">
                <div class="iv-field">
                    <label class="iv-field-label" for="invoice-number">@L["InvoiceNumberLabel"]</label>
                    <div class="iv-field-row">
                        <input type="text" class="form-control iv-num" id="invoice-number"
                               value="@((isFetchingNextInvoiceNumber ? L["LoadingMessage"] : InvoiceFormModel.InvoiceNumber))"
                               @oninput="e => InvoiceFormModel.InvoiceNumber = e.Value?.ToString()!"
                               disabled="@(!isCustomInvoiceNumber)" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleCustomInvoiceNumber">
                            @(isCustomInvoiceNumber ? L["InvoiceNumberUseDefaultButton"] : L["InvoiceNumberCustomizeButton"])
                        </button>
                    </div>
                    <ValidationMessage For="@(() => InvoiceFormModel.InvoiceNumber)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="issue-date">@L["IssueDateLabel"]</label>
                    <input type="date" class="form-control" id="issue-date" @bind="InvoiceFormModel.IssueDate" />
                    <ValidationMessage For="@(() => InvoiceFormModel.IssueDate)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="due-date">@L["DueDateLabel"]</label>
                    <input type="date" class="form-control" id="due-date" @bind="InvoiceFormModel.DueDate" />
                    <ValidationMessage For="@(() => InvoiceFormModel.DueDate)" />
                </div>
            </div>
            <div class="iv-grid-3">
                <div class="iv-field">
                    <label class="iv-field-label" for="vat-date">@L["VatDateLabel"]</label>
                    <input type="date" class="form-control" id="vat-date" @bind="InvoiceFormModel.VatDate" />
                    <ValidationMessage For="@(() => InvoiceFormModel.VatDate)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="currency">@L["CurrencyLabel"]</label>
                    <select class="form-select" id="currency" @bind="InvoiceFormModel.Currency">
                        @foreach (Currency value in Enum.GetValues<Currency>())
                        {
                            <option value="@value">@value</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => InvoiceFormModel.Currency)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="status">@L["StatusLabel"]</label>
                    <select class="form-select" id="status" @bind="InvoiceFormModel.Status">
                        @foreach (InvoiceStatus value in Enum.GetValues<InvoiceStatus>())
                        {
                            <option value="@value">@EnumL.Localize(value)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => InvoiceFormModel.Status)" />
                </div>
            </div>
        </div>

        @* PARTIES *@
        <div class="iv-card">
            <span class="iv-label">@L["SectionParties"]</span>
            <div class="iv-grid-2">
                <div class="iv-field">
                    <label class="iv-field-label" for="seller">@L["SellerLabel"]</label>
                    <select class="form-select" id="seller" @bind="InvoiceFormModel.SellerId" @bind:after="OnChosenSellerChangedAfterBind" disabled="@(InvoiceInstance is not null)">
                        <option value="0">@L["SellerSelectOption"]</option>
                        @foreach (EntityDto entity in AllSellers)
                        {
                            <option value="@entity.Id">@entity.Name</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => InvoiceFormModel.SellerId)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="buyer">@L["BuyerLabel"]</label>
                    <div class="iv-field-row">
                        <select class="form-select" id="buyer" @bind="InvoiceFormModel.BuyerId">
                            <option value="0">@L["BuyerSelectOption"]</option>
                            @foreach (EntityDto entity in AllBuyers)
                            {
                                <option value="@entity.Id">@entity.Name</option>
                            }
                        </select>
                        @if (InvoiceInstance is null)
                        {
                            <button type="button" class="btn btn-outline-secondary iv-btn-square" title="@L["AddEntityButtonTitle"]" @onclick="AddNewEntity">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                                    <path d="M12 5v14" />
                                    <path d="M5 12h14" />
                                </svg>
                            </button>
                        }
                    </div>
                    <ValidationMessage For="@(() => InvoiceFormModel.BuyerId)" />
                </div>
            </div>
        </div>

        @* PAYMENT AND SIGNATURE *@
        <div class="iv-card">
            <span class="iv-label">@L["SectionPayment"]</span>
            <div class="iv-grid-3">
                <div class="iv-field">
                    <label class="iv-field-label" for="payment-method">@L["PaymentMethodLabel"]</label>
                    <select class="form-select" id="payment-method" @bind="InvoiceFormModel.PaymentMethod">
                        <option value="">@L["NoneOption"]</option>
                        @foreach (PaymentMethod value in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@value">@EnumL.Localize(value)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => InvoiceFormModel.PaymentMethod)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="delivery-method">@L["DeliveryMethodLabel"]</label>
                    <select class="form-select" id="delivery-method" @bind="InvoiceFormModel.DeliveryMethod">
                        <option value="">@L["NoneOption"]</option>
                        @foreach (DeliveryMethod value in Enum.GetValues<DeliveryMethod>())
                        {
                            <option value="@value">@EnumL.Localize(value)</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => InvoiceFormModel.DeliveryMethod)" />
                </div>
                <div class="iv-field">
                    <label class="iv-field-label" for="signed-by">@L["SignedByLabel"]</label>
                    <input type="text" class="form-control" id="signed-by" placeholder="@L["SignedByPlaceholder"]" @bind="InvoiceFormModel.SignedBy" />
                </div>
            </div>
        </div>

        @* ITEMS *@
        <div class="iv-card">
            <span class="iv-label">@L["InvoiceItemsHeader"]</span>

            @if (!InvoiceFormModel.Items.Any())
            {
                <p class="iv-empty">@L["NoItemsAddedMessage"]</p>
                <ValidationMessage For="@(() => InvoiceFormModel.Items)" />
            }
            else
            {
                <div class="iv-item-grid iv-item-head iv-label">
                    <span>@L["ItemDescriptionLabel"]</span>
                    <span>@L["ItemQuantityLabel"]</span>
                    <span>@L["ItemUnitLabel"]</span>
                    <span>@L["ItemUnitPriceLabel"]</span>
                    <span>@L["ItemVatRateLabel"]</span>
                    <span class="iv-right">@L["ItemTotalLabel"]</span>
                    <span></span>
                </div>
            }

            @foreach (InvoiceItemFormModel item in InvoiceFormModel.Items)
            {
                int uniqueItemHash = item.GetHashCode();
                <div class="iv-item-grid iv-item-row">
                    <div class="iv-field">
                        <input id="item-description-@uniqueItemHash" type="text" class="form-control form-control-sm" placeholder="@L["ItemDescriptionPlaceholder"]" @bind="item.Description" />
                        <ValidationMessage For="@(() => item.Description)" />
                    </div>
                    <div class="iv-field">
                        <input id="item-quantity-@uniqueItemHash" type="number" min="1" class="form-control form-control-sm iv-num" placeholder="@L["ItemQuantityPlaceholder"]" @bind="item.Quantity" />
                        <ValidationMessage For="@(() => item.Quantity)" />
                    </div>
                    <div class="iv-field">
                        <input id="item-unit-@uniqueItemHash" type="text" class="form-control form-control-sm" placeholder="@L["ItemUnitPlaceholder"]" @bind="item.Unit" />
                        <ValidationMessage For="@(() => item.Unit)" />
                    </div>
                    <div class="iv-field">
                        <input id="item-unit-price-@uniqueItemHash" type="number" min="0" step="any" class="form-control form-control-sm iv-num" placeholder="@L["ItemUnitPricePlaceholder"]" @bind="item.UnitPrice" />
                        <ValidationMessage For="@(() => item.UnitPrice)" />
                    </div>
                    <div class="iv-field">
                        @* Three Czech rates cover almost every line; "other" opens a plain number box. *@
                        @if (IsCustomVat(item))
                        {
                            <div class="iv-field-row">
                                <input id="item-vat-rate-@uniqueItemHash" type="number" min="0" max="100" step="1" class="form-control form-control-sm iv-num" @bind="item.VatRatePercent" />
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => SetVatRate(item, DefaultVatRate)">%</button>
                            </div>
                        }
                        else
                        {
                            <div class="iv-segmented" role="group" aria-label="@L["VatPresetAriaLabel"]">
                                @foreach (int rate in VatPresets)
                                {
                                    <button type="button" class="iv-segment @(item.VatRatePercent == rate ? "active" : null)" @onclick="() => SetVatRate(item, rate)">@rate</button>
                                }
                                <button type="button" class="iv-segment" @onclick="() => EnableCustomVat(item)">@L["VatCustomOption"]</button>
                            </div>
                        }
                        <ValidationMessage For="@(() => item.VatRatePercent)" />
                    </div>
                    <span class="iv-num iv-item-total">@InvoiceFormModel.Currency.FormatAmount(LineTotal(item))</span>
                    <button type="button" class="iv-icon-btn iv-icon-btn-danger" title="@L["RemoveItemButtonTitle"]" @onclick="() => RemoveInvoiceItem(item)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 7h14" />
                            <path d="M9.5 7V5h5v2" />
                            <path d="M6.5 7 7.5 20h9L17.5 7" />
                        </svg>
                    </button>
                </div>
            }

            <button type="button" class="btn iv-btn-dashed" @onclick="AddInvoiceItem">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14" />
                    <path d="M5 12h14" />
                </svg>
                @L["AddItemButtonText"]
            </button>
        </div>
    </div>

    @* The running total stays in view while the items are typed. *@
    <div class="iv-formbar">
        <div class="iv-formbar-totals">
            <div class="iv-total-block">
                <span class="iv-total-label">@L["TotalNetLabel"]</span>
                <span class="iv-num iv-total-value">@InvoiceFormModel.Currency.FormatAmount(TotalNet)</span>
            </div>
            <div class="iv-total-block">
                <span class="iv-total-label">@L["TotalVatLabel"]</span>
                <span class="iv-num iv-total-value">@InvoiceFormModel.Currency.FormatAmount(TotalVat)</span>
            </div>
            <div class="iv-total-block">
                <span class="iv-total-label">@L["TotalGrossLabel"]</span>
                <span class="iv-num iv-total-value iv-total-strong">@InvoiceFormModel.Currency.FormatAmount(TotalNet + TotalVat)</span>
            </div>
        </div>
        <div class="iv-formbar-actions">
            @if (CancelCallback.HasDelegate)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="() => CancelCallback.InvokeAsync()">@L["CancelButtonText"]</button>
            }
            <button type="submit" class="btn btn-primary">@(InvoiceInstance is null ? L["CreateButtonText"] : L["SaveButtonText"])</button>
        </div>
    </div>
</EditForm>

@code {
    // Parameters
    [Parameter] public InvoiceDto? InvoiceInstance { get; set; } = null;
    [Parameter] public EventCallback OnSubmitCallback { get; set; }
    [Parameter, EditorRequired] public bool IsActive { get; set; }
    [Parameter, EditorRequired] public EventCallback AddNewEntityCallback { get; set; }
    [Parameter] public EventCallback CancelCallback { get; set; }

    // Form Models
    private InvoiceFormModel InvoiceFormModel { get; set; } = new();
    private IList<EntityDto> AllEntities = new List<EntityDto>();
    private IList<EntityDto> AllSellers = new List<EntityDto>();
    private IList<EntityDto> AllBuyers = new List<EntityDto>();

    // Variables
    private bool isCustomInvoiceNumber = false;
    private bool isFetchingNextInvoiceNumber = false;
    private string defaultFetchedInvoiceNumber { get; set; } = string.Empty;

    // Constants
    private const string LOADING_MESSAGE = "Loading...";
    private const int DefaultVatRate = 21;
    private static readonly int[] VatPresets = [0, 12, 21];

    // Items whose rate is typed in by hand rather than picked from the presets.
    private readonly HashSet<InvoiceItemFormModel> customVatItems = [];

    private decimal TotalNet => InvoiceFormModel.Items.Sum(LineTotal);

    private decimal TotalVat => InvoiceFormModel.Items.Sum(i => LineTotal(i) * i.VatRatePercent / 100m);

    private static decimal LineTotal(InvoiceItemFormModel item) => item.Quantity * item.UnitPrice;

    private bool IsCustomVat(InvoiceItemFormModel item)
        => customVatItems.Contains(item) || !VatPresets.Contains(item.VatRatePercent);

    private void EnableCustomVat(InvoiceItemFormModel item) => customVatItems.Add(item);

    protected override void OnParametersSet()
    {
        if (InvoiceInstance is not null)
        {
            InvoiceFormModel = InvoiceFormModel.FromDto(InvoiceInstance);
            defaultFetchedInvoiceNumber = InvoiceInstance.InvoiceNumber;
        }
        if (!IsActive)
            ResetForm();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEntities();
    }

    private async Task LoadEntities()
    {
        try
        {
            AllEntities = await entityService.GetAllAsync();
            AllSellers = AllEntities.Where(e => !e.IsClient).ToList();
            AllBuyers = AllEntities.Where(e => e.IsClient).ToList();
        }
        catch (Exception e)
        {
            errorService.ShowError(e.Message);
        }
    }

    private void ToggleCustomInvoiceNumber()
    {
        isCustomInvoiceNumber = !isCustomInvoiceNumber;
        InvoiceFormModel.IsCustomInvoiceNumber = isCustomInvoiceNumber;
        if (!isCustomInvoiceNumber)
            InvoiceFormModel.InvoiceNumber = defaultFetchedInvoiceNumber;
    }

    private async Task SubmitForm() {
        loadingService.StartLoading();
        try 
        {
            if (InvoiceInstance is null)
                await SubmitNewInvoice();
            else
                await SubmitEditInvoice();
            await OnSubmitCallback.InvokeAsync();
            ResetForm();
        } 
        catch (Exception e) 
        {
            errorService.ShowError(e.Message);
        }
        finally 
        {
            loadingService.StopLoading();
        }
    }

    private async Task SubmitNewInvoice() 
    {
        InvoiceDto newInvoice = InvoiceFormModel.ToDto();
        InvoiceDto createdInvoice = await invoiceService.CreateAsync(newInvoice);
    }

    private async Task SubmitEditInvoice()
    {
        if (InvoiceInstance is null)
            return;
        InvoiceDto editedInvoice = InvoiceFormModel.ToDto();
        InvoiceDto updatedInvoice = await invoiceService.UpdateAsync(editedInvoice.Id, editedInvoice);
    }

    private void ResetForm()
    {
        isCustomInvoiceNumber = false;
        defaultFetchedInvoiceNumber = string.Empty;
        InvoiceFormModel.ClearModel();
    }

    private void AddInvoiceItem()
    {
        InvoiceFormModel.AddItem(new());
    }

    private void RemoveInvoiceItem(InvoiceItemFormModel item)
    {
        InvoiceFormModel.RemoveItem(item);
    }

    private async Task OnChosenSellerChangedAfterBind()
    {
        int sellerId = InvoiceFormModel.SellerId;
        InvoiceDto? newInvoice = await GetNewOrUpdatedInvoiceInitialData(sellerId);
        if (newInvoice is null)
            return;
        defaultFetchedInvoiceNumber = newInvoice.InvoiceNumber;
        InvoiceFormModel.InvoiceNumber = defaultFetchedInvoiceNumber;
    }

    private async Task<InvoiceDto?> GetNewOrUpdatedInvoiceInitialData(int sellerId)
    {
        if (sellerId == 0) return null;
        isFetchingNextInvoiceNumber = true;
        try
        {
            InvoiceDto newInvoice = await invoiceService.GetNewInvoiceInformationAsync(sellerId);
            return newInvoice;
        }
        catch (Exception ex)
        {
            errorService.ShowError(ex.Message);
            return null;
        }
        finally
        {
            isFetchingNextInvoiceNumber = false;
        }
    }

    private void SetVatRate(InvoiceItemFormModel item, int ratePercentage)
    {
        item.VatRatePercent = ratePercentage;
        customVatItems.Remove(item);
    }

    private async Task AddNewEntity()
    {
        await AddNewEntityCallback.InvokeAsync();
        await LoadEntities();
    }
}
