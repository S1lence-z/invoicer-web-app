@page "/entities"
@using System.Net
@using Application.DTOs
@using Application.ServiceInterfaces
@using Frontend.Components
@using Frontend.Services
@using Microsoft.Extensions.Localization
@inject IEntityService entityService
@inject ErrorService errorService
@inject NavigationManager navigationManager
@inject IStringLocalizer<Entities> L

<div class="iv-page iv-page-fill">
    <div class="iv-page-head">
        <h1>@L["PageTitle"]</h1>
        <div class="iv-page-actions">
            <div class="iv-segmented iv-filter-group">
                <button type="button" class="iv-segment @(filter == EntityFilter.All ? "active" : null)" @onclick="() => SetFilter(EntityFilter.All)">@L["FilterAllButton"]</button>
                <button type="button" class="iv-segment @(filter == EntityFilter.Mine ? "active" : null)" @onclick="() => SetFilter(EntityFilter.Mine)">@L["FilterMyCompaniesButton"]</button>
                <button type="button" class="iv-segment @(filter == EntityFilter.Clients ? "active" : null)" @onclick="() => SetFilter(EntityFilter.Clients)">@L["FilterClientsButton"]</button>
            </div>
            <button class="btn btn-primary" @onclick="AddNewEntity">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14" />
                    <path d="M5 12h14" />
                </svg>
                @L["AddNewEntityButton"]
            </button>
        </div>
    </div>

    <div class="iv-split">
        <div class="iv-split-list">
            @if (isLoadingData)
            {
                <Spinner />
            }
            else if (shownEntities.Count == 0)
            {
                <p class="iv-empty">@L["NoEntitiesFoundMessage"]</p>
            }
            else
            {
                @foreach (var entity in shownEntities)
                {
                    <EntityListItem Entity="entity" OnSelectEntity="SelectEntity" OnDeleteEntity="DeleteEntity" OnEditEntity="EditEntity" IsSelected="IsEntitySelected(entity)" />
                }
            }
        </div>

        <div class="iv-split-detail">
            @if (selectedEntity is null)
            {
                <p class="iv-empty">@L["SelectEntityPrompt"]</p>
            }
            else
            {
                <EntityDetailView SelectedEntity="selectedEntity" />
            }
        </div>
    </div>
</div>

@code {
    private List<EntityDto> allEntities = new();
    private List<EntityDto> shownEntities = new();
    private EntityDto? selectedEntity = null;
    private bool isLoadingData = true;
    private EntityFilter filter = EntityFilter.All;

    protected override async Task OnInitializedAsync() {
        await LoadEntities();
    }

    private bool IsEntitySelected(EntityDto entity)
    {
        return selectedEntity != null && selectedEntity.Id == entity.Id;
    }

    private async Task LoadEntities() {
        try
        {
            isLoadingData = true;
            allEntities = (await entityService.GetAllAsync()).ToList();
            PopulateShownEntites(allEntities);
        }
        catch (Exception e)
        {
            errorService.ShowError($"Failed to load entities {e.Message}");
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private void SelectEntity(EntityDto newSelectedEntity)
    {
        if (newSelectedEntity == selectedEntity)
        {
            selectedEntity = null;
            return;
        }
        selectedEntity = newSelectedEntity;
    }

    private async Task DeleteEntity(EntityDto entityToDelete)
    {
        try
        {
            var status = await entityService.DeleteAsync(entityToDelete.Id);
            if (status) {
                if (selectedEntity?.Id == entityToDelete.Id)
                    selectedEntity = null;
                await LoadEntities();
            }
        } 
        catch (Exception ex)
        {
            errorService.ShowError(ex.Message);
        }
    }

    private void EditEntity(EntityDto entityToEdit)
    {
        string currentUrl = navigationManager.Uri;
        string encodedReturnUrl = WebUtility.UrlEncode(currentUrl);
        navigationManager.NavigateTo($"entity/edit/{entityToEdit.Id}?returnUrl={encodedReturnUrl}");
    }

    private void AddNewEntity()
    {
        navigationManager.NavigateTo("entity/add");
    }

    private void PopulateShownEntites(List<EntityDto> entities)
    {
        shownEntities.Clear();
        foreach (EntityDto entity in entities)
        {
            shownEntities.Add(entity);
        }
        StateHasChanged();
    }

    // Filtering methods
    private enum EntityFilter { All, Mine, Clients }

    private void SetFilter(EntityFilter newFilter)
    {
        filter = newFilter;
        PopulateShownEntites(filter switch
        {
            EntityFilter.Mine => allEntities.Where(e => !e.IsClient).ToList(),
            EntityFilter.Clients => allEntities.Where(e => e.IsClient).ToList(),
            _ => allEntities
        });
    }
}