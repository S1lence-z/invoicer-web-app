<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Invoicer</AssemblyName>
    <RootNamespace>Desktop</RootNamespace>
    <!-- EF Core and Blazor rely on reflection; never trim the desktop build -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Shell metadata. Product / Company / Authors / Copyright / Version come from
       ..\Directory.Build.props. Forward slash in ApplicationIcon so the linux-x64
       leg can read it too. -->
  <PropertyGroup>
    <AssemblyTitle>Invoicer</AssemblyTitle>
    <Description>Invoicer - create and manage invoices offline</Description>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Windows ships as one self-contained executable. Managed assemblies and native
       libraries go inside the bundle; content (wwwroot\, Assets\, LatoFont\) stays on
       disk next to the exe, which is what Program.cs expects from
       AppContext.BaseDirectory - that keeps returning the *install* folder for a
       single-file app, not the extraction folder.
       Linux keeps the plain self-contained folder layout so that the workflow's
       `ldd Photino.Native.so` assertion keeps working. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-x86' or '$(RuntimeIdentifier)' == 'win-arm64'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Would roughly halve the exe, but the Inno Setup package is LZMA2/solid
         compressed anyway, so it buys nothing on download size while costing
         startup time and memory (compressed bundles cannot be memory-mapped). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.*" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Backend supplies the API and DI setup; Frontend supplies the Blazor WASM static assets,
         which the static web assets pipeline copies into wwwroot/ on publish -->
    <ProjectReference Include="..\Backend\Backend.csproj" />
    <ProjectReference Include="..\Frontend\Frontend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeFromSingleFile guarantees icon.ico / icon.png stay on disk, because
         Program.cs loads the window icon from AppContext.BaseDirectory\Assets\. -->
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Backend is an exe project, so its apphost and host config files ride along into
       the Desktop publish output. UseAppHost=false in Backend.csproj removes Backend.exe;
       this removes the rest, plus the Development appsettings the desktop host can never
       read (Program.cs pins EnvironmentName = Production). -->
  <Target Name="RemoveBackendHostFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_DesktopPublishStrays Include="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RelativePath)' == 'Backend.exe'
                                     or '%(ResolvedFileToPublish.RelativePath)' == 'Backend'
                                     or '%(ResolvedFileToPublish.RelativePath)' == 'Backend.deps.json'
                                     or '%(ResolvedFileToPublish.RelativePath)' == 'Backend.runtimeconfig.json'
                                     or '%(ResolvedFileToPublish.RelativePath)' == 'Backend.staticwebassets.endpoints.json'
                                     or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json'" />
      <ResolvedFileToPublish Remove="@(_DesktopPublishStrays)" />
    </ItemGroup>
  </Target>

</Project>
