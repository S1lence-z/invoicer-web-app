# Frontend port exposed on host (nginx serves static files + proxies /api/ to backend)
APP_PORT=5180

# Base path for reverse proxy subpath deployment (default: root)
API_BASE_URL=http://localhost:${APP_PORT}/api/

# Backend
ASPNETCORE_ENVIRONMENT=Production

# Database provider: Sqlite or PostgreSql
DatabaseProvider=Sqlite

# SQLite connection string (used when DatabaseProvider=Sqlite)
ConnectionStrings__sqliteConnection=Data Source=/data/Invoicer.db

# PostgreSQL connection string (used when DatabaseProvider=PostgreSql)
# Point this to your external PostgreSQL instance
ConnectionStrings__pgsqlConnection=Host=your-postgres-host;Database=invoicer;Username=invoicer;Password=changeme
